{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",

    "spacing": 0,

    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "sway/workspaces",
        "sway/scratchpad",
        "sway/mode",
        "wlr/taskbar",
    ],
    "modules-center": [
        "niri/window",
        "sway/window"
    ],
    "modules-right": [
        "tray", 
        // "idle_inhibitor", 
        "pulseaudio", 
        // "keyboard-state", 
        "backlight", 
        "battery", 
        "clock"
    ],

    "niri/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
        },
        "cursor": true,
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "persistent-workspaces": {
            "1": [],
            "2": [], 
            "3": [],
            "4": []
        },
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
        },
        // "cursor": true,
    },
    "sway/mode": {
        "format": "<b>{}</b>"
    },
    "sway/scratchpad": {
        "format": "{icon}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "wlr/taskbar": {
        "on-click": "activate",
        "spacing": 5,
        "ignore-list": [
            "Alacritty"
        ],
        "cursor": true
    },
    "idle_inhibitor": {
        "format": "{icon} ",
        "format-icons": {
            // "activated": "",
            // "deactivated": ""
            "activated": "\ue163",
            "deactivated": "\ue163"
            // "activated": "目覚め",
            // "deactivated": "眠り"
        }
    },
    "tray": {
        "icon-size": 20,
        "spacing": 2,
        "icons": {
            // "discord": "face-monkey",
        },
        "cursor": true,
    },
    "clock": {
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#d8dee9'><b>{}</b></span>",
                "days":       "<span color='#b48ead'><b>{}</b></span>",
                "weeks":      "<span color='#8fbcbb'><b>W{}</b></span>",
                "weekdays":   "<span color='#ebcb8b'><b>{}</b></span>",
                "today":      "<span color='#bf616a'><b><u>{}</u></b></span>"
            }
        },
        "tooltip-format": "<span size='14pt' font='HackGen35 Console NF'>{calendar}</span>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon}",
        // "format-alt": "{percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 10.0,
        "tooltip": true,
        "tooltip-format": "{percent}%",
        "on-click": "$HOME/.config/rofi/applets/brightness.sh"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "",
        "format-plugged": "",
        // "format-alt": "{time} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true,
        "tooltip-format": "{time} {capacity}%",
        "on-click": "$HOME/.config/rofi/applets/battery.sh"
    },
    "network": {
        "format-wifi": "<span></span>",
        "format-ethernet": "",
        "tooltip-format": "{ifname} via {gwaddr} \n{essid} ({signalStrength}%) 󰤨",
        "format-linked": "",
        "format-disconnected": "󰤮",
        "format-alt": "{ifname}: {ipaddr}/{cidr} {essid} ({signalStrength}%)"
    },
    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon}{format_source}",
        "format-bluetooth": "{icon}{format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip": true,
        "tooltip-format": "{desc} {volume}% {icon}",
        "on-click": "$HOME/.config/rofi/applets/volume.sh"
    },
    "custom/launcher": {
        // "format": "火山",
        // "format": "󱗼",
        "format": "\uf0c9",
        "on-click": "$HOME/.config/rofi/launcher/drun.sh",
        "tooltip-format": "Launcher\n\nSuper + S",
        "tooltip": true
    }
}
