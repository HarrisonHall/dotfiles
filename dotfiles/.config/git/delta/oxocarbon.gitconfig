[delta "oxocarbon"]
	blame-palette = "#393939 #262626 #161616 #525252 #A3A3A3"
	commit-decoration-style = "#262626" bold box ul
	dark = true
	file-decoration-style = "#525252"
	file-style = "#be95ff"
	hunk-header-decoration-style = "#A3A3A3" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a6adc8"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#A3A3A3"
	line-numbers-minus-style = bold "#F490BB"
	line-numbers-plus-style = bold "#85D59C"
	line-numbers-right-style = "#525252"
	line-numbers-zero-style = "#525252"
	# 25% red 75% base
	minus-emph-style = bold syntax "#833458"
	# 10% red 90% base
	minus-style = syntax "#57233A"
	# 25% green 75% base
	plus-emph-style = bold syntax "#307343"
	# 10% green 90% base
	plus-style = syntax "#1E482A"
	map-styles = \
		bold purple => syntax "#be95ff", \
		bold blue => syntax "#33b1ff", \
		bold cyan => syntax "#3ddbd9", \
		bold yellow => syntax "#ffe966"
	# Should match the name of the bat theme
	syntax-theme = "Oxocarbon Dark"
	# syntax-theme = "oxocarbon"
